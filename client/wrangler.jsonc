{
  // Static-assets-only Worker: serves the Vite build output in ./dist.
  // Without this file, `wrangler deploy` falls into its framework
  // auto-configuration path and tries to rewrite vite.config.js.
  "name": "melachaite-travel",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
